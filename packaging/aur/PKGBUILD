# Maintainer: jamillejung <izeystudio@gmail.com>
pkgname=wireguard-tui
pkgver=1.10.0
pkgrel=1
pkgdesc="Terminal UI for managing WireGuard tunnels with wg and wg-quick"
arch=('x86_64' 'aarch64')
url="https://github.com/JamilleJung/wireguard-tui"
license=('MIT')
# The privileged helper runs wg/wg-quick (which need ip from iproute2) and the
# kill switch uses nftables, falling back to iptables (pulled in by iproute2).
# Passwordless polkit access also needs administrator-managed membership in
# the wireguard group and an active local session.
depends=('glibc' 'libgcc' 'wireguard-tools' 'iproute2' 'polkit' 'hicolor-icon-theme')
makedepends=('cargo')
# The helper's process tests spawn python3.
checkdepends=('python')
optdepends=('nftables: kill switch (preferred over the iptables fallback)'
            'openresolv: resolvconf for configs with a DNS line'
            'sudo: sudoers-based helper authorization instead of polkit'
            'wl-clipboard: copy to the Wayland clipboard'
            'xclip: copy to the X11 clipboard'
            'minisign: verify release signatures')
install=wireguard-tui.install
# Cargo's release profile already strips the binaries; a debug package would
# hold only dangling build-id links.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('03bd0dfac0996473fe71616b717eceb22ae4cc3637dd5c4a79a602ef878bb309')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/wg-tui "$pkgdir/usr/bin/wg-tui"
    install -Dm755 target/release/wg-helper "$pkgdir/usr/lib/$pkgname/wg-helper"
    install -Dm644 packaging/49-wireguard-tui.rules "$pkgdir/usr/share/polkit-1/rules.d/49-wireguard-tui.rules"
    install -Dm644 packaging/wireguard-tui.desktop "$pkgdir/usr/share/applications/wireguard-tui.desktop"
    install -Dm644 packaging/wireguard-tui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wireguard-tui.svg"
    # Tells the in-app updater that pacman owns this copy.
    printf 'format=1\napp=%s\nmethod=package\nmanager=pacman\n' "$pkgname" \
        > "$pkgdir/usr/lib/$pkgname/install-manifest"
    chmod 644 "$pkgdir/usr/lib/$pkgname/install-manifest"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
