pkgbase = wireguard-tui
	pkgdesc = Terminal UI for managing WireGuard tunnels with wg and wg-quick
	pkgver = 1.10.0
	pkgrel = 1
	url = https://github.com/JamilleJung/wireguard-tui
	install = wireguard-tui.install
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = python
	makedepends = cargo
	depends = glibc
	depends = libgcc
	depends = wireguard-tools
	depends = iproute2
	depends = polkit
	depends = hicolor-icon-theme
	optdepends = nftables: kill switch (preferred over the iptables fallback)
	optdepends = openresolv: resolvconf for configs with a DNS line
	optdepends = sudo: sudoers-based helper authorization instead of polkit
	optdepends = wl-clipboard: copy to the Wayland clipboard
	optdepends = xclip: copy to the X11 clipboard
	optdepends = minisign: verify release signatures
	options = !debug
	source = wireguard-tui-1.10.0.tar.gz::https://github.com/JamilleJung/wireguard-tui/archive/refs/tags/v1.10.0.tar.gz
	sha256sums = 03bd0dfac0996473fe71616b717eceb22ae4cc3637dd5c4a79a602ef878bb309

pkgname = wireguard-tui
