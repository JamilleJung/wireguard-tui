# A copy installed by install.sh under /usr/local shadows this package on PATH.
case "${ACTION}" in
post)
	if [ -e usr/local/bin/wg-tui ] || [ -e usr/local/lib/wireguard-tui/wg-helper ]; then
		echo "WARNING: another wireguard-tui is installed under /usr/local and shadows"
		echo "         this package. Remove it with: PREFIX=/usr/local ./install.sh uninstall"
	fi
	;;
esac
