# Contributor: jamillejung <izeystudio@gmail.com>
# Maintainer: jamillejung <izeystudio@gmail.com>
pkgname=wireguard-tui
pkgver=1.9.3
pkgrel=0
pkgdesc="Terminal UI for managing WireGuard tunnels with wg and wg-quick"
url="https://github.com/JamilleJung/wireguard-tui"
arch="x86_64 aarch64"
license="MIT"
# wg-quick needs iproute2; the kill switch uses nftables.
depends="wireguard-tools iproute2 nftables polkit"
makedepends="cargo cargo-auditable"
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/JamilleJung/wireguard-tui/archive/refs/tags/v$pkgver.tar.gz"
# net: cargo fetch in prepare(); build() and check() run offline (--frozen).
options="net"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/wg-tui "$pkgdir"/usr/bin/wg-tui
	install -Dm755 target/release/wg-helper "$pkgdir"/usr/lib/$pkgname/wg-helper
	install -Dm644 packaging/49-wireguard-tui.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/49-wireguard-tui.rules
	install -Dm644 packaging/wireguard-tui.desktop \
		"$pkgdir"/usr/share/applications/wireguard-tui.desktop
	install -Dm644 packaging/wireguard-tui.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/wireguard-tui.svg
	# Tells the in-app updater that apk owns this copy.
	printf 'format=1\napp=%s\nmethod=package\nmanager=apk\n' "$pkgname" \
		> "$pkgdir"/usr/lib/$pkgname/install-manifest
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
c1edba46ec2ad798c5ab19e157ea295b55d2c237445794a87794dd5907d9173394f74e361a3e6fde5605d8e89d35325956cace23ad77b5838d754e12c7f970b2  wireguard-tui-1.9.3.tar.gz
"
